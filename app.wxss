page {
  background: #f6f7fb;
  color: #1f2430;
  font-size: 28rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
  position: relative;
  z-index: 1;
}

.card {
  background: rgba(255, 255, 255, 0.56);
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.62);
  box-shadow: 0 8rpx 28rpx rgba(26, 33, 52, 0.1);
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2430;
}

.muted {
  color: #8690a3;
}

.primary-btn {
  background: #ff8c69;
  color: #ffffff;
  border-radius: 999rpx;
  font-weight: 500;
  border: none;
}

.ghost-btn {
  background: #ffffff;
  color: #ff8c69;
  border-radius: 999rpx;
  border: 2rpx solid #ff8c69;
}
