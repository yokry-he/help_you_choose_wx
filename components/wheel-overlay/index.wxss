.wheel-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.wheel-wrap {
  width: 310px;
  height: 310px;
  margin-top: 20%;
  position: relative;
}

.wheel-canvas {
  width: 310px;
  height: 310px;
}

.wheel-needle {
  position: absolute;
  left: 50%;
  top: 6rpx;
  margin-left: -18rpx;
  width: 0;
  height: 0;
  border-left: 18rpx solid transparent;
  border-right: 18rpx solid transparent;
  border-top: 40rpx solid #ff8c69;
  filter: drop-shadow(0 4rpx 10rpx rgba(35, 42, 64, 0.2));
}

.wheel-center {
  position: absolute;
  left: 50%;
  top: 50%;
  margin-left: -24px;
  margin-top: -24px;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #ffffff;
  border: 2px solid #ffd7cb;
  font-size: 24px;
  line-height: 40px;
  text-align: center;
  color: #ff8c69;
  font-weight: 700;
}

.wheel-sub {
  text-align: center;
  color: #ffffff;
  font-size: 26rpx;
  min-height: 40rpx;
  margin-top: 16rpx;
  width: 100%;
}
