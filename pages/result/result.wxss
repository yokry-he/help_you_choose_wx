.confetti-wrap {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 420rpx;
  pointer-events: none;
  z-index: 50;
}

.confetti-canvas {
  width: 750rpx;
  height: 420rpx;
}

.question-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.question-icon-wrap {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.question-card {
  flex: 1;
}

.question {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #1f2430;
  line-height: 1.15;
}

.tone-row {
  margin-top: 22rpx;
}

.tone-label {
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.tone-scroll {
  white-space: nowrap;
}

.tone-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid;
  font-size: 24rpx;
  background: #ffffff;
}

.tone-pill-active {
  color: #ffffff;
}

.result-card {
  margin: 18rpx 0;
  padding: 34rpx 24rpx 30rpx;
  position: relative;
  overflow: hidden;
}

.result-title {
  text-align: center;
  font-size: 46rpx;
  font-weight: 800;
  color: #1f2430;
  position: relative;
  z-index: 1;
}

.result-badge {
  margin: 22rpx auto 0;
  min-width: 188rpx;
  max-width: 420rpx;
  border-radius: 22rpx;
  padding: 18rpx 30rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: 50rpx;
  font-weight: 800;
  position: relative;
  z-index: 1;
}

.result-hint {
  margin-top: 18rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

.field-title {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
  color: #1f2430;
}

.options-card {
  padding: 24rpx 24rpx 16rpx;
}

.opt-item {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.opt-left {
  display: flex;
  align-items: center;
}

.opt-dot {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 3rpx solid #c6cedb;
  background: #ffffff;
  margin-right: 16rpx;
  box-sizing: border-box;
}

.opt-dot-selected {
  position: relative;
}

.opt-dot-selected::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  margin-left: -5rpx;
  margin-top: -5rpx;
  border-radius: 50%;
  background: #ffffff;
}

.opt-text {
  font-size: 28rpx;
  color: #4a5568;
}

.selected-tag {
  min-width: 118rpx;
  height: 54rpx;
  border-radius: 28rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 54rpx;
  text-align: center;
  font-weight: 700;
}

.btn-group {
  margin-top: 24rpx;
}

.action-btn {
  margin-top: 14rpx;
  height: 82rpx;
  line-height: 82rpx;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 26rpx;
}

.action-primary {
  color: #ffffff;
}

.action-ghost {
  background: #ffffff;
}

.action-share {
  background: #ffffff;
}

.half-actions {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.half-btn {
  margin-top: 0;
  flex: 1;
}

.history-btn {
  color: #88d5f2;
  border-color: #88d5f2;
}

.pulse {
  animation: pulse 0.8s ease-out;
}

@keyframes pulse {
  0% {
    transform: scale(0.92);
    opacity: 0.5;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}
