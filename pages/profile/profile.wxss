.profile-page {
  padding: 0 0 20rpx;
}

.hero {
  padding: 30rpx 28rpx 34rpx;
  min-height: 248rpx;
  box-sizing: border-box;
  color: #ffffff;
  border-bottom-left-radius: 26rpx;
  border-bottom-right-radius: 26rpx;
  margin-bottom: 18rpx;
  position: relative;
  overflow: hidden;
}

.hero-bubbles {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.hero-noise {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(
    rgba(255, 255, 255, 0.16) 1px,
    transparent 1px
  );
  background-size: 18rpx 18rpx;
  opacity: 0.35;
}

.bubble {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.b1 {
  width: 210rpx;
  height: 210rpx;
  right: -24rpx;
  top: -22rpx;
}

.b2 {
  width: 118rpx;
  height: 118rpx;
  left: 26rpx;
  top: 24rpx;
}

.b3 {
  width: 150rpx;
  height: 150rpx;
  right: 170rpx;
  top: 54rpx;
  background: rgba(255, 255, 255, 0.08);
}

.b4 {
  width: 88rpx;
  height: 88rpx;
  right: 56rpx;
  bottom: 16rpx;
  background: rgba(255, 255, 255, 0.14);
}

.star {
  position: absolute;
  color: rgba(255, 255, 255, 0.52);
  font-size: 22rpx;
}

.s1 {
  right: 108rpx;
  top: 28rpx;
}

.s2 {
  right: 44rpx;
  top: 108rpx;
}

.hero-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  border: 5rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  position: relative;
  z-index: 1;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 46rpx;
  font-weight: 800;
  position: relative;
  z-index: 1;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
  position: relative;
  z-index: 1;
}

.hero-streak {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.92;
  position: relative;
  z-index: 1;
}

.badge-card {
  margin: 0 24rpx 18rpx;
}

.badge-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.badge-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.badge-item {
  border-radius: 16rpx;
  padding: 16rpx;
  background: #f8f9fc;
}

.badge-earned {
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 4rpx 14rpx rgba(30, 36, 52, 0.06);
}

.badge-locked {
  opacity: 0.55;
}

.badge-icon {
  font-size: 34rpx;
  margin-bottom: 8rpx;
}

.badge-name {
  font-size: 26rpx;
  font-weight: 700;
}

.badge-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.menu-card {
  margin: 16rpx 24rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.menu-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.menu-icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: 16rpx;
  background: #f4eefc;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  font-size: 30rpx;
}

.menu-main {
  min-width: 0;
}

.menu-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1f2430;
}

.menu-desc {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: #b0b8c6;
}

.menu-arrow {
  color: #c2c9d6;
  font-size: 34rpx;
  line-height: 1;
}
